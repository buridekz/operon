# Agora Console → your project → Config. Enable RTC, RTM and Conversational AI on the project.
AGORA_APP_ID=
AGORA_APP_CERT=

# Public HTTPS URL of this server (from your tunnel, e.g. https://xxxx.trycloudflare.com).
# Agora's cloud calls ${PUBLIC_URL}/chat/completions every turn, so it cannot be localhost.
PUBLIC_URL=

# Shared secret Agora sends as "Authorization: Bearer <LLM_KEY>" to /chat/completions.
LLM_KEY=change-me-to-something-random

CHANNEL=operon-or3
PORT=3000

# Speech: Agora ARES recognition, Agora-managed TTS (no extra API keys).
ASR_LANGUAGE=en-US
TTS_PRESET=openai_tts_1
TTS_VOICE=coral

# Demo clock: 1000 makes one "minute" pass every second, so the 60-minute tourniquet alert fires in 60 s.
DEMO_MINUTE_MS=60000

# Optional LLM fallback: turns messy commands into a fixed intent (strict JSON). Never confirms,
# never doses, never writes what Vega says. Leave empty to run rules-only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
